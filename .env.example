# Instellingen die in Railway onder Variables moeten staan.
# Kopieer dit bestand naar .env voor lokaal gebruik.

# Wachtwoord waarmee de beheerder de eerste keer inlogt.
# Wordt alleen gebruikt als er nog geen beheerder bestaat.
ADMIN_WACHTWOORD=verzin-hier-een-goed-wachtwoord

# Willekeurige lange tekst waarmee het inlog-cookie ondertekend wordt.
# Verander je die, dan moet iedereen opnieuw inloggen.
SESSION_SECRET=plak-hier-een-lange-willekeurige-tekst

# Volledige adres van de site, zonder schuine streep aan het eind.
SITE_URL=https://www.klusspecialistvanduijn.nl

# Verzenden van contactformulieren.
RESEND_API_KEY=

# Map waar de database en foto's staan. In Railway is dit het volume.
DATA_DIR=/data
